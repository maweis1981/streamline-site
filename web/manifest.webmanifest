{
  "name": "都播网页版",
  "short_name": "Doubo",
  "description": "都播网页版是一个免费的在线 M3U / M3U8 播放器。无需下载、无需注册，粘贴播放列表链接或导入文件，就能在电脑和手机浏览器里按分组浏览、搜索和观看直播频道。",
  "lang": "zh",
  "start_url": "/web/?source=pwa",
  "scope": "/web/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#05070F",
  "theme_color": "#05070F",
  "categories": [
    "entertainment",
    "video"
  ],
  "icons": [
    {
      "src": "/assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
