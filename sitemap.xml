---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | where_exp: "p", "p.ref" | where_exp: "p", "p.ref != '404'" | where_exp: "p", "p.noindex != true" -%}
{%- for p in pages %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    {%- for l in site.languages %}
    {%- if l == site.default_lang %}{% assign l_path = "/" | append: p.path_key %}{% else %}{% assign l_path = "/" | append: l | append: "/" | append: p.path_key %}{% endif %}
    <xhtml:link rel="alternate" hreflang="{{ site.data.locales[l].html_lang }}" href="{{ l_path | absolute_url }}"/>
    {%- endfor %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
</urlset>
